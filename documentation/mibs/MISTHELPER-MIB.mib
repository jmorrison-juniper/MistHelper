mistSiteMistListSiteDiscoveredAssets OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteDiscoveredAssets endpoint. The
         gateway names this reading mist_list_site_discovered_assets."
    ::= { mistSiteEntry 43 }


mistSiteMistListSiteDiscoveredSwitchesMetrics OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteDiscoveredSwitchesMetrics
         endpoint. The gateway names this reading
         mist_list_site_discovered_switches_metrics."
    ::= { mistSiteEntry 44 }


mistSiteMistListSiteMxEdgesStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteMxEdgesStats endpoint. The gateway
         names this reading mist_list_site_mx_edges_stats."
    ::= { mistSiteEntry 45 }


mistSiteMistListSiteRssiZonesStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteRssiZonesStats endpoint. The
         gateway names this reading mist_list_site_rssi_zones_stats."
    ::= { mistSiteEntry 46 }


mistSiteMistListSiteSlesMetrics OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteSlesMetrics endpoint. The gateway
         names this reading mist_list_site_sles_metrics."
    ::= { mistSiteEntry 47 }


mistSiteMistListSiteSpectrumAnalysis OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteSpectrumAnalysis endpoint. The
         gateway names this reading mist_list_site_spectrum_analysis."
    ::= { mistSiteEntry 48 }


mistSiteMistListSiteTroubleshootCalls OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteTroubleshootCalls endpoint. The
         gateway names this reading mist_list_site_troubleshoot_calls."
    ::= { mistSiteEntry 49 }


mistSiteMistListSiteUnconnectedClientStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteUnconnectedClientStats endpoint.
         The gateway names this reading
         mist_list_site_unconnected_client_stats."
    ::= { mistSiteEntry 50 }


mistSiteMistListSiteWirelessClientsStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteWirelessClientsStats endpoint. The
         gateway names this reading
         mist_list_site_wireless_clients_stats."
    ::= { mistSiteEntry 51 }


mistSiteMistListSiteZonesStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the listSiteZonesStats endpoint. The gateway
         names this reading mist_list_site_zones_stats."
    ::= { mistSiteEntry 52 }


mistSiteMistSearchSiteAssets OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteAssets endpoint. The gateway
         names this reading mist_search_site_assets."
    ::= { mistSiteEntry 53 }


mistSiteMistSearchSiteBgpStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteBgpStats endpoint. The gateway
         names this reading mist_search_site_bgp_stats."
    ::= { mistSiteEntry 54 }


mistSiteMistSearchSiteCalls OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteCalls endpoint. The gateway
         names this reading mist_search_site_calls."
    ::= { mistSiteEntry 55 }


mistSiteMistSearchSiteDiscoveredSwitches OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteDiscoveredSwitches endpoint. The
         gateway names this reading
         mist_search_site_discovered_switches."
    ::= { mistSiteEntry 56 }


mistSiteMistSearchSiteDiscoveredSwitchesMetrics OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteDiscoveredSwitchesMetrics
         endpoint. The gateway names this reading
         mist_search_site_discovered_switches_metrics."
    ::= { mistSiteEntry 57 }


mistSiteMistSearchSiteOspfStats OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteOspfStats endpoint. The gateway
         names this reading mist_search_site_ospf_stats."
    ::= { mistSiteEntry 58 }


mistSiteMistSearchSiteSwOrGwPorts OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the searchSiteSwOrGwPorts endpoint. The
         gateway names this reading mist_search_site_sw_or_gw_ports."
    ::= { mistSiteEntry 59 }


mistSiteMistTroubleshootSiteCall OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Statistics from the troubleshootSiteCall endpoint. The gateway
         names this reading mist_troubleshoot_site_call."
    ::= { mistSiteEntry 60 }


mistSiteIdentity OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..255))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The identity of the record in this row. SNMP carries no label,
         so read this object to learn which record the row number
         describes."
    ::= { mistSiteEntry 99 }

mistSiteIndex OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "The position of the row. The agent counts from 1. The agent
         does not answer a request for this object, because the row
         number is already the last part of every cell OID."
    ::= { mistSiteEntry 100 }

-- ---------------------------------------------------------------------
-- Subtree 3: the Device table.
-- Each cell answers at <base>.3.1.<column>.<row>
-- ---------------------------------------------------------------------

mistDeviceTable OBJECT-TYPE
    SYNTAX SEQUENCE OF MistDeviceEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "One row for each Device record that the gateway reads."
    ::= { mistHelperMIB 3 }

mistDeviceEntry OBJECT-TYPE
    SYNTAX MistDeviceEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "The readings of one row. Read mistDeviceIdentity to learn
         which record the row describes."
    INDEX { mistDeviceIndex }
    ::= { mistDeviceTable 1 }


MistDeviceEntry ::= SEQUENCE {
    mistDeviceInfo DisplayString,
    mistDeviceUp Gauge32,
    mistDeviceUptimeSeconds Gauge32,
    mistDeviceLastSeenTimestamp Gauge32,
    mistDeviceClients Gauge32,
    mistDeviceCpuUtilization Gauge32,
    mistDeviceMemoryUsedBytes Gauge32,
    mistDeviceMemoryTotalBytes Gauge32,
    mistDevicePowerBudgetWatts Gauge32,
    mistDeviceCpuTemperatureCelsius Gauge32,
    mistDeviceReceivedBytes Counter64,
    mistDeviceTransmittedBytes Counter64,
    mistDeviceCertificateExpiryTimestamp Gauge32,
    mistDeviceIdentity DisplayString,
    mistDeviceIndex Integer32
}


mistDeviceInfo OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..255))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "A constant 1. The labels carry the device name, model, serial
         number, and running firmware version. The gateway names this
         reading mist_device_info."
    ::= { mistDeviceEntry 1 }


mistDeviceUp OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "1 when Mist Cloud reports the device as connected, and 0 for
         every other state. The gateway names this reading
         mist_device_up."
    ::= { mistDeviceEntry 2 }


mistDeviceUptimeSeconds OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "seconds"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "How long, in seconds, has the device been up (or rebooted) The
         gateway names this reading mist_device_uptime_seconds."
    ::= { mistDeviceEntry 3 }


mistDeviceLastSeenTimestamp OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "seconds"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Last seen timestamp The gateway names this reading
         mist_device_last_seen_timestamp_seconds."
    ::= { mistDeviceEntry 4 }


mistDeviceClients OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "wireless"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "How many wireless clients are currently connected The gateway
         names this reading mist_device_clients."
    ::= { mistDeviceEntry 5 }


mistDeviceCpuUtilization OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "ten-thousandths"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The share of the processor that the device is using, from 0 to
         1. SNMP reports ten-thousandths. SNMP reports ten-thousandths.
         The gateway names this reading
         mist_device_cpu_utilization_ratio."
    ::= { mistDeviceEntry 6 }


mistDeviceMemoryUsedBytes OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "bytes"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The memory the device is using, in bytes. The gateway names
         this reading mist_device_memory_used_bytes."
    ::= { mistDeviceEntry 7 }


mistDeviceMemoryTotalBytes OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "bytes"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The memory the device holds, in bytes. The gateway names this
         reading mist_device_memory_total_bytes."
    ::= { mistDeviceEntry 8 }


mistDevicePowerBudgetWatts OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "watts"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "In mW, surplus if positive or deficit if negative The gateway
         names this reading mist_device_power_budget_watts."
    ::= { mistDeviceEntry 9 }


mistDeviceCpuTemperatureCelsius OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "degrees Celsius"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The processor temperature the device reports, in degrees
         Celsius. The gateway names this reading
         mist_device_cpu_temperature_celsius."
    ::= { mistDeviceEntry 10 }


mistDeviceReceivedBytes OBJECT-TYPE
    SYNTAX Counter64
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Amount of traffic received since connection The gateway names
         this reading mist_device_received_bytes_total."
    ::= { mistDeviceEntry 11 }


mistDeviceTransmittedBytes OBJECT-TYPE
    SYNTAX Counter64
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "Amount of traffic sent since connection The gateway names this
         reading mist_device_transmitted_bytes_total."
    ::= { mistDeviceEntry 12 }


mistDeviceCertificateExpiryTimestamp OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "seconds"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The moment the device certificate expires, in seconds since
         the epoch. The gateway names this reading
         mist_device_certificate_expiry_timestamp_seconds."
    ::= { mistDeviceEntry 13 }


mistDeviceIdentity OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..255))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The identity of the record in this row. SNMP carries no label,
         so read this object to learn which record the row number
         describes."
    ::= { mistDeviceEntry 99 }

mistDeviceIndex OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "The position of the row. The agent counts from 1. The agent
         does not answer a request for this object, because the row
         number is already the last part of every cell OID."
    ::= { mistDeviceEntry 100 }

-- ---------------------------------------------------------------------
-- Subtree 4: the Sle table.
-- Each cell answers at <base>.4.1.<column>.<row>
-- ---------------------------------------------------------------------

mistSleTable OBJECT-TYPE
    SYNTAX SEQUENCE OF MistSleEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "One row for each Sle record that the gateway reads."
    ::= { mistHelperMIB 4 }

mistSleEntry OBJECT-TYPE
    SYNTAX MistSleEntry
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "The readings of one row. Read mistSleIdentity to learn
         which record the row describes."
    INDEX { mistSleIndex }
    ::= { mistSleTable 1 }


MistSleEntry ::= SEQUENCE {
    mistSleUserMinutesTotal Gauge32,
    mistSleUserMinutesOk Gauge32,
    mistSleRatio Gauge32,
    mistSleIdentity DisplayString,
    mistSleIndex Integer32
}


mistSleUserMinutesTotal OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The total user minutes that the service level expectation
         measured. The gateway names this reading
         mist_org_sle_user_minutes_total."
    ::= { mistSleEntry 1 }


mistSleUserMinutesOk OBJECT-TYPE
    SYNTAX Gauge32
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The user minutes that met the service level expectation. The
         gateway names this reading mist_org_sle_user_minutes_ok."
    ::= { mistSleEntry 2 }


mistSleRatio OBJECT-TYPE
    SYNTAX Gauge32
    UNITS "ten-thousandths"
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The share of user minutes that met the service level
         expectation, from 0 to 1. SNMP reports ten-thousandths. SNMP
         reports ten-thousandths. The gateway names this reading
         mist_org_sle_ratio."
    ::= { mistSleEntry 3 }


mistSleIdentity OBJECT-TYPE
    SYNTAX DisplayString (SIZE (0..255))
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION
        "The identity of the record in this row. SNMP carries no label,
         so read this object to learn which record the row number
         describes."
    ::= { mistSleEntry 99 }

mistSleIndex OBJECT-TYPE
    SYNTAX Integer32 (1..2147483647)
    MAX-ACCESS not-accessible
    STATUS current
    DESCRIPTION
        "The position of the row. The agent counts from 1. The agent
         does not answer a request for this object, because the row
         number is already the last part of every cell OID."
    ::= { mistSleEntry 100 }

-- ---------------------------------------------------------------------
-- Conformance
-- ---------------------------------------------------------------------

mistHelperConformance OBJECT-IDENTITY
    STATUS current
    DESCRIPTION
        "The groups and the compliance statement of this module."
    ::= { mistHelperMIB 100 }

mistHelperGroups OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "The object groups of this module."
    ::= { mistHelperConformance 1 }

mistHelperCompliances OBJECT-IDENTITY
    STATUS current
    DESCRIPTION "The compliance statements of this module."
    ::= { mistHelperConformance 2 }


mistOrgGroup OBJECT-GROUP
    OBJECTS {
        mistOrgInfo,
        mistOrgSites,
        mistOrgDevices,
        mistOrgInventory,
        mistOrgDevicesConnected,
        mistOrgDevicesDisconnected,
        mistOrgMistCountOrgAssetsByDistanceField,
        mistOrgMistCountOrgBgpStats,
        mistOrgMistCountOrgOspfStats,
        mistOrgMistCountOrgPeerPathStats,
        mistOrgMistCountOrgSwOrGwPorts,
        mistOrgMistCountOrgTunnelsStats,
        mistOrgMistGetOrgMxEdgeStats,
        mistOrgMistGetOrgOtherDeviceStats,
        mistOrgMistListOrgAssetsStats,
        mistOrgMistListOrgBgpStats,
        mistOrgMistListOrgDevicesStats,
        mistOrgMistListOrgMxEdgesStats,
        mistOrgMistListOrgOspfStats,
        mistOrgMistListOrgPeerPathStats,
        mistOrgMistListOrgSiteStats,
        mistOrgMistListOrgSwOrGwPorts,
        mistOrgMistListOrgTunnelsStats,
        mistOrgMistSearchOrgAssets,
        mistOrgMistSearchOrgBgpStats,
        mistScrapeSuccess,
        mistScrapeAgeSeconds,
        mistScrapeDurationMilliseconds
    }
    STATUS current
    DESCRIPTION "The objects of the Org scope."
    ::= { mistHelperGroups 1 }


mistSiteGroup OBJECT-GROUP
    OBJECTS {
        mistSiteInfo,
        mistSiteAps,
        mistSiteApsConnected,
        mistSiteSwitches,
        mistSiteSwitchesConnected,
        mistSiteGateways,
        mistSiteGatewaysConnected,
        mistSiteDevices,
        mistSiteDevicesConnected,
        mistSiteClients,
        mistSiteMistCountSiteApps,
        mistSiteMistCountSiteAssets,
        mistSiteMistCountSiteBgpStats,
        mistSiteMistCountSiteCalls,
        mistSiteMistCountSiteDiscoveredSwitches,
        mistSiteMistCountSiteOspfStats,
        mistSiteMistCountSiteSwOrGwPorts,
        mistSiteMistGetSiteAllClientsStatsByDevice,
        mistSiteMistGetSiteAssetStats,
        mistSiteMistGetSiteAssetsOfInterest,
        mistSiteMistGetSiteCallsSummary,
        mistSiteMistGetSiteDeviceStats,
        mistSiteMistGetSiteDiscoveredAssetByMap,
        mistSiteMistGetSiteGatewayMetrics,
        mistSiteMistGetSiteInsightMetricsForGateway,
        mistSiteMistGetSiteMxEdgeStats,
        mistSiteMistGetSiteRssiZoneStats,
        mistSiteMistGetSiteSdkStats,
        mistSiteMistGetSiteSdkStatsByMap,
        mistSiteMistGetSiteStats,
        mistSiteMistGetSiteSwitchesMetrics,
        mistSiteMistGetSiteWirelessClientStats,
        mistSiteMistGetSiteWirelessClientsStatsByMap,
        mistSiteMistGetSiteWxRulesUsage,
        mistSiteMistGetSiteZoneStats,
        mistSiteMistListInsightMetrics,
        mistSiteMistListSiteAssetsStats,
        mistSiteMistListSiteBeaconsStats,
        mistSiteMistListSiteDevicesStats,
        mistSiteMistListSiteDiscoveredAssets,
        mistSiteMistListSiteDiscoveredSwitchesMetrics,
        mistSiteMistListSiteMxEdgesStats,
        mistSiteMistListSiteRssiZonesStats,
        mistSiteMistListSiteSlesMetrics,
        mistSiteMistListSiteSpectrumAnalysis,
        mistSiteMistListSiteTroubleshootCalls,
        mistSiteMistListSiteUnconnectedClientStats,
        mistSiteMistListSiteWirelessClientsStats,
        mistSiteMistListSiteZonesStats,
        mistSiteMistSearchSiteAssets,
        mistSiteMistSearchSiteBgpStats,
        mistSiteMistSearchSiteCalls,
        mistSiteMistSearchSiteDiscoveredSwitches,
        mistSiteMistSearchSiteDiscoveredSwitchesMetrics,
        mistSiteMistSearchSiteOspfStats,
        mistSiteMistSearchSiteSwOrGwPorts,
        mistSiteMistTroubleshootSiteCall,
        mistSiteIdentity
    }
    STATUS current
    DESCRIPTION "The objects of the Site scope."
    ::= { mistHelperGroups 2 }


mistDeviceGroup OBJECT-GROUP
    OBJECTS {
        mistDeviceInfo,
        mistDeviceUp,
        mistDeviceUptimeSeconds,
        mistDeviceLastSeenTimestamp,
        mistDeviceClients,
        mistDeviceCpuUtilization,
        mistDeviceMemoryUsedBytes,
        mistDeviceMemoryTotalBytes,
        mistDevicePowerBudgetWatts,
        mistDeviceCpuTemperatureCelsius,
        mistDeviceReceivedBytes,
        mistDeviceTransmittedBytes,
        mistDeviceCertificateExpiryTimestamp,
        mistDeviceIdentity
    }
    STATUS current
    DESCRIPTION "The objects of the Device scope."
    ::= { mistHelperGroups 3 }


mistSleGroup OBJECT-GROUP
    OBJECTS {
        mistSleUserMinutesTotal,
        mistSleUserMinutesOk,
        mistSleRatio,
        mistSleIdentity
    }
    STATUS current
    DESCRIPTION "The objects of the Sle scope."
    ::= { mistHelperGroups 4 }


mistHelperCompliance MODULE-COMPLIANCE
    STATUS current
    DESCRIPTION
        "The gateway serves every object of this module as read-only.
         The gateway refuses every write request, because it never
         changes Mist Cloud."
    MODULE
        MANDATORY-GROUPS {
            mistOrgGroup,
            mistSiteGroup,
            mistDeviceGroup,
            mistSleGroup
        }
    ::= { mistHelperCompliances 1 }

END
