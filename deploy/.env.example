# MistHelper Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ============================================================
# Required Variables
# ============================================================

# Juniper Mist API authentication token
# Obtain from Mist Dashboard > Organization > Settings > API Token
MIST_API_TOKEN=your_api_token_here

# Mist organization UUID
# Found in Mist Dashboard URL: https://manage.mist.com/admin/?org_id=<THIS_VALUE>
MIST_ORG_ID=your_org_id_here

# ============================================================
# Optional Variables
# ============================================================

# API page size for paginated requests (default: 1000)
# MIST_PAGE_LIMIT=1000

# Maximum concurrent connections in fast mode (default: 8)
# FAST_MODE_MAX_CONCURRENT_CONNECTIONS=8

# Cache freshness for fast mode CSV reuse in minutes (default: 5)
# CSV_FRESHNESS_MINUTES=5

# Output format: csv or sqlite (default: csv)
# OUTPUT_FORMAT=csv

# SQLite database path (default: data/mist_data.db)
# DATABASE_PATH=data/mist_data.db

# Web portal port (default: 8055)
# WEB_PORT=8055

# SSID Template Consolidation specific variables
# Cache freshness window for SSID Template Consolidation collector (minutes, default: 60)
# SSID_CONSOLIDATION_CACHE_MINUTES=60

# Optional base name for generated templates (overrides default basename derived from target SSID)
# MIST_TEMPLATE_BASENAME=misthelper

# Default target SSID for consolidation runs. If unset, the CLI will require an explicit value.
# MIST_TARGET_SSID=CorpSecure
