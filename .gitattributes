# Normalize line endings across platforms
* text=auto

# Force LF for source files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf

# Force CRLF for Windows-specific files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary

# Merge concurrent changelog entries
CHANGELOG.md text eol=lf merge=union
