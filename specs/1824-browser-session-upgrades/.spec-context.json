  ],
  "intent": "Let an operator safely prepare and review a site upgrade when no environment token exists at portal startup.",
  "expectations": [
    "Do not start a real firmware upgrade.",
    "Do not store, expose, log, export, or commit a raw browser token."
  ],
  "approach": "Use the existing in-memory session registry for a GetSelf-derived browser identity and enforce selected device types before target records are stored.",
  "decisions": [
    {
      "decision": "Freeze environment token availability at factory startup",
      "why": "The browser token field must appear only when boot had no environment token.",
      "rejected": "Reading the environment on each request."
    },
    {
      "decision": "Use the safe GetSelf token name as browser-token identity",
      "why": "Audit and site lock holder data need an operator-readable nonsecret identity.",
      "rejected": "Using a raw token, its digest, or a typed email."
    },
    {
      "decision": "Enforce selected types in target construction",
      "why": "A browser-only filter cannot stop a crafted submitted plan.",
      "rejected": "Filtering only table rows."
    },
    {
      "decision": "Fall back to highest compatible model version",
      "why": "A shared type override can be unavailable for mixed models.",
      "rejected": "Applying the highest type-wide version."
    }
  ],
