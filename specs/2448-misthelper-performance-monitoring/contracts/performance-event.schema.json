{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmorrison-juniper/MistHelper/specs/2448-misthelper-performance-monitoring/contracts/performance-event.schema.json",
  "title": "MistHelper performance event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "timestamp_utc",
    "monitor_type",
    "source",
    "status",
    "sample_rate",
    "dimensions",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "operation",
        "http",
        "database",
        "file",
        "serialization",
        "cache",
        "startup",
        "diagnostic"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "monitor_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "symbol"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "cancelled",
        "timeout"
      ]
    },
    "sample_rate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "dimensions": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 96
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "measurements": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "integer",
          "number"
        ],
        "minimum": 0
      }
    }
  }
}
