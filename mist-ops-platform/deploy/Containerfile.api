# ---------------------------------------------------------------------------
# Containerfile.api — FastAPI service container
# Multi-stage build for minimal production image
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System dependencies (libpq for asyncpg)
RUN apt-get update \
    && apt-get install --no-install-recommends -y libpq5 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
FROM base AS builder

RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY docs/ ./docs/
COPY src/ ./src/
RUN pip install --prefix=/install .

# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=builder /install /usr/local

COPY src/ ./src/
COPY migrations/ ./migrations/
COPY alembic.ini ./

RUN useradd --create-home --shell /bin/bash mistops
USER mistops

EXPOSE 8000

# WHY: the session store refuses the process-local fallback when more than one
# worker runs, so the operator can name the count (issue #2051).
ENV WEB_WORKERS=4

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import httpx; httpx.get('http://localhost:8000/api/v1/healthz').raise_for_status()"]

# WHY: a shell form lets the entrypoint read WEB_WORKERS from the environment.
ENTRYPOINT ["sh", "-c", "uvicorn src.api.main:create_app --factory \
            --host 0.0.0.0 --port 8000 \
            --workers ${WEB_WORKERS:-4} --log-level info"]
